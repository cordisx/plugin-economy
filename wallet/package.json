{
  "name": "@cordisx/plugin-economy-wallet",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Shared virtual entertainment Token wallet",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "README.zh-Hans.md"
  ],
  "main": "./dist/runtime/module.js",
  "types": "./dist/types/wallet.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/wallet.d.ts",
      "import": "./dist/runtime/module.js",
      "default": "./dist/runtime/module.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "check": "npm run typecheck && npm run build && npm test",
    "dev": "cordisx dev ./src/wallet.tsx",
    "dev:dry-run": "cordisx dev ./src/wallet.tsx --dry-run",
    "test": "tsc -p tsconfig.json --declaration false --outDir .cache/test-runtime && node --test test/manifest.mjs test/local-worker.mjs test/wallet-view.mjs test/public-services.mjs test/commerce-facade.mjs && node --experimental-transform-types --test test/session.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "dprint fmt --config ../dprint.json",
    "format:check": "dprint check --config ../dprint.json",
    "lint": "npm --prefix .. run lint"
  },
  "devDependencies": {
    "@cordisx/economy": "file:../.cache/sdk/cordisx-economy-terminal-r38-final-normal.tgz",
    "@cordisx/protocol": "file:../.cache/sdk/cordisx-protocol-wallet-spend-r36-normal.tgz",
    "@deepseek-ai/cordis": "4.0.1",
    "cordisx": "file:../.cache/sdk/cordisx-host-wallet-spend-r37-normal.tgz",
    "typescript": "^5.9.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.19"
  },
  "overrides": {
    "@cordisx/protocol": "$@cordisx/protocol"
  }
}
