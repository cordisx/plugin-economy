{
  "includes": [
    "**/*.{ts,tsx,js,mjs,json,md,css}"
  ],
  "excludes": [
    "**/node_modules/**",
    "**/dist/**",
    "**/package-lock.json",
    ".cache/**"
  ],
  "typescript": {
    "quoteStyle": "preferSingle",
    "semiColons": "asi"
  },
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.23.3",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm"
  ]
}
